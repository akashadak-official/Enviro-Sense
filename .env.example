# Copy this file to .env and fill it in. Never commit .env to GitHub.

PORT=3000
# Long random text that signs login cookies (at least 16 characters)
JWT_SECRET=change-me-to-a-long-random-text

# Admin account (created on first start)
ADMIN_USER=hitadmin
ADMIN_PASS=choose-a-strong-password
ADMIN_PHONE=
ADMIN_EMAIL=

# Key the Raspberry Pi (or any sensor) sends with every reading. Must match pi/simulator.py
DEVICE_KEY=change-me-to-another-random-text

# NASA FIRMS map key (free): https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_KEY=

# Email codes and alerts through Gmail (leave empty: messages print in the server terminal as [DEMO EMAIL])
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# SMS through Fast2SMS (leave empty: messages print in the terminal as [DEMO SMS])
FAST2SMS_KEY=
FAST2SMS_ROUTE=q

# Fixed location for Local mode (defaults to Haldia)
LOCAL_NAME=Haldia
LOCAL_LAT=22.0667
LOCAL_LON=88.0698

# AI briefing writers, tried in this order: ollama, gemini, claude. "offline" = built-in text only.
BRIEF_PROVIDER=offline
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# DEMO_OUTPUT=1          To send the otps in the local terminal
# ---- Online demo only (see README, "Free online demo") ----
# DEMO_MODE=1            guest login, no email codes, password reset off
# VIRTUAL_SENSOR=1       built-in simulated sensor with "simulate a fire" buttons
# TRUST_PROXY=1          set when the host puts a proxy in front of the app
# NODE_ENV=production    marks cookies "secure" (needs https)
# DB_PATH=               custom database file location
# AUTO_SYNC=1            check NASA for new days once a day (needs FIRMS_KEY)
# KEEP_READING_DAYS=3    how long sensor readings are kept in the demo
# CALL_COUNDOWN=0  